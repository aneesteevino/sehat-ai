# Copy to .env for local development. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000

# Optional database connection. Use a least-privilege Atlas user.
MONGODB_URI=
MONGODB_DATABASE=sehat_ai

# Optional provider token. The application must run tests without this value.
HF_TOKEN=
LLM_PROVIDER=mock
LLM_MODEL=
GENERATION_MINIMUM_SCORE=0.13
GENERATION_TIMEOUT_SECONDS=8
GENERATION_MAX_ATTEMPTS=2

# Security values must be generated locally and never committed.
AUTH_SECRET=
SESSION_TTL_MINUTES=60
KNOWLEDGE_REGISTRY_PATH=data/source_registry/sources.json
